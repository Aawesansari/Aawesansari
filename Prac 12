import heapq

class Graph:
    def __init__(self):
        self.graph = {}  # adjacency list

    def add_edge(self, u, v, time):
        # undirected graph (both ways)
        self.graph.setdefault(u, []).append((v, time))
        self.graph.setdefault(v, []).append((u, time))

    def dijkstra(self, start):
        # Initialize distances
        distances = {node: float('inf') for node in self.graph}
        distances[start] = 0

        # Min-heap for selecting shortest edge
        pq = [(0, start)]  # (time, node)

        while pq:
            current_time, current_node = heapq.heappop(pq)

            # Skip if we found a better path already
            if current_time > distances[current_node]:
                continue

            # Explore neighbors
            for neighbor, travel_time in self.graph[current_node]:
                time = current_time + travel_time
                if time < distances[neighbor]:
                    distances[neighbor] = time
                    heapq.heappush(pq, (time, neighbor))

        return distances

    def display_graph(self):
        print("\nGraph (Location Connections):")
        for node, neighbors in self.graph.items():
            print(f"{node} → {neighbors}")


# ----------------------------------------------------------
# MAIN PROGRAM
# ----------------------------------------------------------
if __name__ == "__main__":
    g = Graph()

    # Add edges (Example city map)
    # Format: g.add_edge('Location1', 'Location2', time_in_minutes)
    g.add_edge('Shop', 'A', 10)
    g.add_edge('Shop', 'B', 15)
    g.add_edge('A', 'C', 12)
    g.add_edge('B', 'D', 10)
    g.add_edge('C', 'D', 2)
    g.add_edge('C', 'E', 1)
    g.add_edge('D', 'E', 5)

    g.display_graph()

    start = 'Shop'
    print(f"\nStarting delivery from: {start}")
    min_times = g.dijkstra(start)

    print("\nMinimum time to deliver pizza to each location:")
    for location, time in min_times.items():
        print(f"→ {location}: {time} minutes")
