# Hash Table implementation using Chaining (Linked Lists)

class Node:
    """A node to store key-value pairs."""
    def __init__(self, key, value):
        self.key = key
        self.value = value
        self.next = None


class HashTable:
    def __init__(self, size=10):
        self.size = size
        self.table = [None] * size  # array of linked lists

    # Hash Function (Division Method)
    def hash_function(self, key):
        return key % self.size

    # 1️⃣ Insert key-value pair
    def insert(self, key, value):
        index = self.hash_function(key)
        new_node = Node(key, value)

        # If no node exists at this index
        if self.table[index] is None:
            self.table[index] = new_node
            print(f"✅ Inserted ({key}, {value}) at index {index}")
        else:
            # Collision -> Chaining (add at end of linked list)
            temp = self.table[index]
            while temp:
                if temp.key == key:
                    temp.value = value  # Update if key already exists
                    print(f"✏️ Updated key {key} with new value {value}")
                    return
                if temp.next is None:
                    break
                temp = temp.next
            temp.next = new_node
            print(f"⚡ Collision occurred! Added ({key}, {value}) at index {index} via chaining.")

    # 2️⃣ Search for a key
    def search(self, key):
        index = self.hash_function(key)
        temp = self.table[index]
        while temp:
            if temp.key == key:
                print(f"🔍 Found key {key} with value: {temp.value}")
                return temp.value
            temp = temp.next
        print("⚠️ Key not found.")
        return None

    # 3️⃣ Delete a key
    def delete(self, key):
        index = self.hash_function(key)
        temp = self.table[index]
        prev = None
        while temp:
            if temp.key == key:
                if prev is None:
                    self.table[index] = temp.next
                else:
                    prev.next = temp.next
                print(f"🗑️ Deleted key {key} successfully!")
                return
            prev = temp
            temp = temp.next
        print("⚠️ Key not found. Cannot delete.")

    # 4️⃣ Display Hash Table
    def display(self):
        print("\n📦 Hash Table Contents:")
        for i in range(self.size):
            print(f"Index {i}:", end=" ")
            temp = self.table[i]
            if not temp:
                print("Empty")
            else:
                while temp:
                    print(f"({temp.key} → {temp.value})", end=" -> ")
                    temp = temp.next
                print("None")


# Main Menu
if __name__ == "__main__":
    ht = HashTable()

    while True:
        print("\n----- Hash Table Operations -----")
        print("1. Insert Key-Value Pair")
        print("2. Search Key")
        print("3. Delete Key")
        print("4. Display Hash Table")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ")

        if choice == '1':
            key = int(input("Enter Key (integer): "))
            value = input("Enter Value: ")
            ht.insert(key, value)

        elif choice == '2':
            key = int(input("Enter Key to Search: "))
            ht.search(key)

        elif choice == '3':
            key = int(input("Enter Key to Delete: "))
            ht.delete(key)

        elif choice == '4':
            ht.display()

        elif choice == '5':
            print("👋 Exiting program...")
            break

        else:
            print("⚠️ Invalid choice! Try again.")
