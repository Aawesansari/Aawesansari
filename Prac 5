# Real-Time Event Processing System using Queue

from collections import deque  # Efficient queue implementation

class EventProcessingSystem:
    def __init__(self):
        self.event_queue = deque()  # Queue to store events (FIFO)

    # 1️⃣ Add an event
    def add_event(self, event_name):
        self.event_queue.append(event_name)
        print(f"✅ Event '{event_name}' added to the queue.")

    # 2️⃣ Process the next event
    def process_event(self):
        if not self.event_queue:
            print("⚠️ No events to process.")
            return
        event = self.event_queue.popleft()
        print(f"⚙️ Processing event: '{event}'")

    # 3️⃣ Display all pending events
    def display_events(self):
        if not self.event_queue:
            print("📭 No pending events in the queue.")
            return
        print("📋 Pending Events in Queue:")
        for i, event in enumerate(self.event_queue, start=1):
            print(f"{i}. {event}")

    # 4️⃣ Cancel a specific event
    def cancel_event(self, event_name):
        if event_name in self.event_queue:
            self.event_queue.remove(event_name)
            print(f"❌ Event '{event_name}' has been canceled and removed from the queue.")
        else:
            print(f"⚠️ Event '{event_name}' not found or already processed.")


# Main Program
if __name__ == "__main__":
    system = EventProcessingSystem()

    while True:
        print("\n----- Real-Time Event Processing Menu -----")
        print("1. Add an Event")
        print("2. Process Next Event")
        print("3. Display Pending Events")
        print("4. Cancel an Event")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ")

        if choice == '1':
            event = input("Enter event name to add: ")
            system.add_event(event)

        elif choice == '2':
            system.process_event()

        elif choice == '3':
            system.display_events()

        elif choice == '4':
            event = input("Enter event name to cancel: ")
            system.cancel_event(event)

        elif choice == '5':
            print("👋 Exiting event processing system...")
            break

        else:
            print("⚠️ Invalid choice. Try again.")
